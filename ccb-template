#!/bin/sh
set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")" && pwd)

usage() {
  cat <<'EOF'
usage: ./ccb-template init [TARGET]
       ./ccb-template brief TARGET
       ./ccb-template manager-prompt TARGET BRIEF_FILE
       ./ccb-template monitor TARGET
       ./ccb-template monitor start|stop|watch|price TARGET
       ./ccb-template start TARGET

Create a new Git project configured with CCB-TEMPLATE. The command interactively
selects one installed Ollama Cloud model for each permanent CCB agent.

`brief` creates a dated execution brief in TARGET/.ccb/briefs/.
`manager-prompt` prints the prompt to paste into the CCB manager conversation.
`monitor` is the unified dashboard, service control and local price-estimation interface.
EOF
}

shell_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

is_monitored_project() {
  [ -f "$1/.ccb/token-monitor/port" ] && [ ! -L "$1/.ccb/token-monitor/port" ] || \
    [ -f "$1/.ccb-template/token-monitor/port" ] && [ ! -L "$1/.ccb-template/token-monitor/port" ]
}

monitor_restore_assets() {
  restore_target=$1 restore_dir=$restore_target/.ccb/token-monitor restore_backup=$restore_target/.ccb-template/token-monitor
  [ -d "$restore_target/.ccb" ] && [ ! -L "$restore_target/.ccb" ] || { printf '%s\n' 'error: CCB configuration is missing; re-run the template installer before starting CCB.' >&2; return 1; }
  [ ! -L "$restore_dir" ] && [ ! -L "$restore_backup" ] || { printf '%s\n' 'error: unsafe token monitor directory.' >&2; return 1; }
  mkdir -p "$restore_dir"
  if [ ! -f "$restore_target/.ccb/token-proxy.py" ]; then
    source_proxy=$restore_backup/token-proxy.py
    [ -f "$source_proxy" ] || source_proxy=$ROOT/assets/token-proxy.py
    cp "$source_proxy" "$restore_target/.ccb/token-proxy.py"
    chmod 600 "$restore_target/.ccb/token-proxy.py"
    printf '%s\n' 'Restored token monitor proxy asset.'
  fi
  if [ ! -f "$restore_target/.ccb/token-monitor-python" ] && [ -f "$restore_backup/python" ]; then
    cp "$restore_backup/python" "$restore_target/.ccb/token-monitor-python"
    chmod 600 "$restore_target/.ccb/token-monitor-python"
    printf '%s\n' 'Restored token monitor Python setting.'
  fi
  if [ ! -f "$restore_dir/port" ] && [ -f "$restore_backup/port" ]; then
    cp "$restore_backup/port" "$restore_dir/port"
    chmod 600 "$restore_dir/port"
    printf '%s\n' 'Restored token monitor port setting.'
  fi
  if [ ! -f "$restore_dir/pricing.json" ]; then
    source_pricing=$restore_backup/pricing.json
    [ -f "$source_pricing" ] || source_pricing=$ROOT/assets/token-pricing.json
    cp "$source_pricing" "$restore_dir/pricing.json"
    chmod 600 "$restore_dir/pricing.json"
    printf '%s\n' 'Restored token monitor pricing configuration.'
  fi
}

monitor_port_for() {
  port_file=$1/.ccb/token-monitor/port
  [ -f "$port_file" ] && [ ! -L "$port_file" ] || { printf '%s\n' 'error: token monitor port setting is missing.' >&2; return 1; }
  port=$(sed -n '1p' "$port_file")
  case "$port" in *[!0-9]*|'') printf 'error: invalid token monitor port: %s\n' "$port" >&2; return 1 ;; esac
  [ "$port" -ge 1024 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || { printf 'error: invalid token monitor port: %s\n' "$port" >&2; return 1; }
  printf '%s\n' "$port"
}

monitor_python_for() {
  python_target=$1
  monitor_python=python3
  monitor_python_file=$python_target/.ccb/token-monitor-python
  if [ -f "$monitor_python_file" ] && [ ! -L "$monitor_python_file" ]; then
    monitor_python=$(sed -n '1p' "$monitor_python_file")
  fi
  command -v "$monitor_python" >/dev/null 2>&1 || {
    printf 'error: token monitor Python is unavailable: %s\n' "$monitor_python" >&2
    return 1
  }
  printf '%s\n' "$monitor_python"
}

monitor_config_matches_port() {
  config_target=$1 config_port=$2 config_file=$1/.ccb/ccb.config
  [ -f "$config_file" ] && [ ! -L "$config_file" ] || { printf '%s\n' 'error: CCB configuration is missing.' >&2; return 1; }
  for agent in manager graph developer reviewer; do
    grep -Fqx "ANTHROPIC_BASE_URL = \"http://127.0.0.1:$config_port/$agent\"" "$config_file" || {
      printf 'error: CCB token monitor URL is inconsistent for %s; re-run the template installer.\n' "$agent" >&2
      return 1
    }
  done
}

monitor_start() {
  monitor_target=$1
  is_monitored_project "$monitor_target" || { printf '%s\n' 'error: token monitoring was not enabled for this project.' >&2; return 1; }
  monitor_restore_assets "$monitor_target"
  monitor_dir=$monitor_target/.ccb/token-monitor
  [ ! -L "$monitor_dir" ] || { printf '%s\n' 'error: unsafe token monitor directory.' >&2; return 1; }
  mkdir -p "$monitor_dir"
  monitor_pid=$monitor_dir/proxy.pid
  if [ -f "$monitor_pid" ] && kill -0 "$(cat "$monitor_pid")" 2>/dev/null; then
    printf 'Token monitor already running (pid %s).\n' "$(cat "$monitor_pid")"
    return 0
  fi
  monitor_python=$(monitor_python_for "$monitor_target") || return 1
  "$monitor_python" -c 'import aiohttp' >/dev/null 2>&1 || { printf 'error: token monitor Python needs aiohttp: %s\n' "$monitor_python" >&2; return 1; }
  monitor_port=$(monitor_port_for "$monitor_target")
  monitor_config_matches_port "$monitor_target" "$monitor_port"
  nohup "$monitor_python" "$monitor_target/.ccb/token-proxy.py" --upstream http://127.0.0.1:11434 --port "$monitor_port" --metrics "$monitor_dir/usage.jsonl" >"$monitor_dir/proxy.log" 2>&1 &
  printf '%s\n' "$!" >"$monitor_pid"
  attempts=0
  while [ "$attempts" -lt 20 ]; do
    if "$monitor_python" -c 'import sys, urllib.request; urllib.request.urlopen(sys.argv[1], timeout=0.2).read()' "http://127.0.0.1:$monitor_port/health" >/dev/null 2>&1; then
      printf 'Token monitor started (pid %s, port %s).\n' "$(cat "$monitor_pid")" "$monitor_port"
      return 0
    fi
    attempts=$((attempts + 1))
    sleep 0.1
  done
  kill "$(cat "$monitor_pid")" 2>/dev/null || :
  rm -f "$monitor_pid"
  printf 'error: token monitor did not become ready on port %s; inspect %s\n' "$monitor_port" "$monitor_dir/proxy.log" >&2
  return 1
}

monitor_stop() {
  monitor_target=$1 monitor_pid=$monitor_target/.ccb/token-monitor/proxy.pid
  [ -f "$monitor_pid" ] || { printf '%s\n' 'Token monitor is not running.'; return 0; }
  pid=$(cat "$monitor_pid")
  if kill -0 "$pid" 2>/dev/null; then kill "$pid"; fi
  rm -f "$monitor_pid"
  printf '%s\n' 'Token monitor stopped.'
}

monitor_watch() {
  monitor_target=$1
  monitor_start "$monitor_target"
  printf '\033[?25l\033[2J\033[H'
  trap 'printf "\033[?25h\n"' EXIT HUP INT TERM
  while :; do
    printf '\033[H'
    show_usage "$monitor_target"
    printf '\033[J'
    sleep 2
  done
}

open_monitor_terminal() {
  terminal_target=$1
  command -v osascript >/dev/null 2>&1 || { printf '%s\n' 'warning: cannot open a terminal automatically; run ccb-template monitor watch TARGET manually.' >&2; return 0; }
  terminal_command="$(shell_quote "$ROOT/ccb-template") monitor watch $(shell_quote "$terminal_target")"
  osascript - "$terminal_command" <<'APPLESCRIPT'
on run argv
  tell application "Terminal"
    activate
    do script item 1 of argv
  end tell
end run
APPLESCRIPT
}

show_usage() {
  usage_target=$1 usage_file=$usage_target/.ccb/token-monitor/usage.jsonl
  [ -f "$usage_file" ] || { printf '%s\n' 'No token usage recorded yet.'; return 0; }
  usage_python=$(monitor_python_for "$usage_target") || return 1
  "$usage_python" - "$usage_file" "$usage_target/.ccb/token-monitor/pricing.json" <<'PY'
import json
import sys
from datetime import datetime, timedelta, timezone
from collections import defaultdict

usage_file, pricing_file = sys.argv[1:]
try:
    pricing = json.load(open(pricing_file, encoding="utf-8")).get("models", {})
except (FileNotFoundError, json.JSONDecodeError, AttributeError):
    pricing = {}

events = []
for line in open(usage_file, encoding="utf-8"):
    try:
        events.append(json.loads(line))
    except json.JSONDecodeError:
        continue
totals = defaultdict(lambda: [0, 0, 0])
recent = [0, 0, 0]
now = datetime.now(timezone.utc)
for event in events:
    key = (event.get("agent") or "unknown", event.get("model") or "unknown")
    input_tokens = event.get("input_tokens") or 0
    output_tokens = event.get("output_tokens") or 0
    totals[key][0] += input_tokens
    totals[key][1] += output_tokens
    totals[key][2] += 1
    try:
        if datetime.fromisoformat(event["timestamp"]).astimezone(timezone.utc) >= now - timedelta(minutes=5):
            recent[0] += input_tokens
            recent[1] += output_tokens
            recent[2] += 1
    except (KeyError, ValueError):
        pass

total_input = sum(value[0] for value in totals.values())
total_output = sum(value[1] for value in totals.values())
total_requests = sum(value[2] for value in totals.values())
has_color = not bool(__import__("os").environ.get("NO_COLOR"))
def color(code, text): return f"\033[{code}m{text}\033[0m" if has_color else text
def bar(share):
    width = 16
    filled = round(width * share)
    return color("36", "█" * filled) + color("90", "░" * (width - filled))
def estimate(model, input_tokens, output_tokens):
    rate = pricing.get(model)
    if not isinstance(rate, dict): return None
    try:
        return input_tokens / 1_000_000 * float(rate["input_per_million_usd"]) + output_tokens / 1_000_000 * float(rate["output_per_million_usd"])
    except (KeyError, TypeError, ValueError): return None

estimated_costs = [estimate(model, data[0], data[1]) for (_, model), data in totals.items()]
known_costs = [cost for cost in estimated_costs if cost is not None]
print(color("1;36", "   /\\_/\\    CCB Scout"), "·", now.astimezone().strftime("%Y-%m-%d %H:%M:%S"))
print(color("1;36", "  ( o.o )   token watch active"))
print(color("1;36", "   > ^ <"), color("90", "refreshes every 2 seconds · Ctrl-C to stop"))
print(f"Total  {total_input:,} input  ·  {total_output:,} output  ·  {total_requests} requests")
if totals and len(known_costs) == len(totals):
    print(color("33", f"Estimated cost  ~${sum(known_costs):.4f} USD"), color("90", "(local pricing configuration)"))
else:
    print(color("90", "Estimated cost  unavailable — configure .ccb/token-monitor/pricing.json"))
print(f"Last 5 min  {recent[0]:,} input  ·  {recent[1]:,} output  ·  {recent[2]} requests")
print()
print("AGENT       MODEL                         INPUT      OUTPUT   SHARE                 REQS    EST. USD")
print("─" * 106)
for (agent, model), (input_tokens, output_tokens, requests) in sorted(totals.items()):
    share = input_tokens / total_input if total_input else 0
    cost = estimate(model, input_tokens, output_tokens)
    alert = color("31", " ⚠") if share >= 0.70 else ""
    rendered_cost = f"${cost:.4f}" if cost is not None else "n/a"
    print(f"{agent:<11} {model:<29} {input_tokens:>10,} {output_tokens:>11,}  {bar(share)} {share:>5.1%}{alert} {requests:>6}  {rendered_cost:>10}")
if any(data[0] / total_input >= 0.70 for data in totals.values()) if total_input else False:
    print()
    print(color("33", "⚠ Alert:"), "an agent uses 70% or more of input tokens.")
PY
}

show_pricing() {
  pricing_target=$1 pricing_file=$pricing_target/.ccb/token-monitor/pricing.json
  [ -f "$pricing_file" ] || { printf 'No pricing file found: %s\n' "$pricing_file"; return 1; }
  printf 'Local estimation rates: %s\n\n' "$pricing_file"
  cat "$pricing_file"
  printf '\n\nUse this format; rates are USD per million tokens and are never treated as Ollama billing data:\n'
  printf '{"models":{"model:cloud":{"input_per_million_usd":2.0,"output_per_million_usd":8.0}}}\n'
}

print_manager_prompt() {
  prompt_target=$1 prompt_brief=$2
  case "$prompt_brief" in
    *'/'*|*'..'*) printf '%s\n' 'error: brief file must be a filename inside .ccb/briefs.' >&2; return 1 ;;
  esac
  [ -d "$prompt_target" ] && [ ! -L "$prompt_target" ] && [ -f "$prompt_target/.ccb/briefs/$prompt_brief" ] && [ ! -L "$prompt_target/.ccb/briefs/$prompt_brief" ] || {
    printf 'error: brief not found: %s/.ccb/briefs/%s\n' "$prompt_target" "$prompt_brief" >&2
    return 1
  }
  cat <<EOF
You are the CCB manager for this project.

Read .ccb/briefs/$prompt_brief and treat it as the requested scope.
First confirm the objective, assumptions, acceptance criteria and risks. Then delegate architecture
analysis to graph, implementation only to developer, and independent validation to reviewer.
Follow .ccb/AGENT_POLICY.md and do not modify application files yourself. Report concise progress,
validation evidence and any decision that needs the user's approval.
EOF
}

write_brief() {
  brief_target=$1 brief_name=$2
  [ -d "$brief_target" ] && [ ! -L "$brief_target" ] && [ -d "$brief_target/.ccb" ] && [ ! -L "$brief_target/.ccb" ] || {
    printf 'error: not a CCB project: %s\n' "$brief_target" >&2
    return 1
  }
  brief_dir=$brief_target/.ccb/briefs
  [ ! -L "$brief_dir" ] || { printf 'error: unsafe brief directory: %s\n' "$brief_dir" >&2; return 1; }
  mkdir -p "$brief_dir"
  brief_file=$brief_dir/$brief_name.md
  [ ! -e "$brief_file" ] || { printf 'error: brief already exists: %s\n' "$brief_file" >&2; return 1; }
  brief_temp=$(mktemp "$brief_dir/.brief.XXXXXX") || return 1
  trap 'rm -f "$brief_temp"' EXIT HUP INT TERM
  printf '# CCB Brief\n\n' >"$brief_temp"
  printf 'Describe the requested work. End with a line containing only a dot (.):\n' >&2
  lines=0
  while IFS= read -r line; do
    [ "$line" = . ] && break
    printf '%s\n' "$line" >>"$brief_temp"
    lines=$((lines + 1))
  done
  [ "$lines" -gt 0 ] || { rm -f "$brief_temp"; trap - EXIT HUP INT TERM; printf '%s\n' 'No brief created.'; return 0; }
  chmod 600 "$brief_temp" && mv "$brief_temp" "$brief_file"
  trap - EXIT HUP INT TERM
  printf 'Brief created: %s\n' "$brief_file"
}

choose_model() {
  role=$1
  while :; do
    printf '\nChoose the Ollama Cloud model for %s:\n' "$role" >&2
    index=1
    printf '%s\n' "$cloud_models" | while IFS= read -r model; do
      printf '  %s) %s\n' "$index" "$model" >&2
      index=$((index + 1))
    done
    printf '> ' >&2
    IFS= read -r choice || exit 1
    case "$choice" in
      *[!0-9]*|'') printf 'Enter the number of a listed model.\n' >&2; continue ;;
    esac
    selected=$(printf '%s\n' "$cloud_models" | sed -n "${choice}p")
    [ -n "$selected" ] || { printf 'Enter the number of a listed model.\n' >&2; continue; }
    printf '%s\n' "$selected"
    return 0
  done
}

[ "$#" -gt 0 ] || { usage >&2; exit 2; }
command=$1
shift
case "$command" in
  brief)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    write_brief "$1" "brief-$(date +%Y%m%d-%H%M%S)"
    exit $?
    ;;
  manager-prompt)
    [ "$#" -eq 2 ] || { usage >&2; exit 2; }
    print_manager_prompt "$1" "$2"
    exit $?
    ;;
  monitor)
    case "$#" in
      1) show_usage "$1" ;;
      2) case "$1" in start) monitor_start "$2" ;; stop) monitor_stop "$2" ;; watch) monitor_watch "$2" ;; price) show_pricing "$2" ;; *) usage >&2; exit 2 ;; esac ;;
      *) usage >&2; exit 2 ;;
    esac
    exit $?
    ;;
  start)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    if is_monitored_project "$1"; then monitor_start "$1"; fi
    cd "$1" && exec ccb
    ;;
  init) [ "$#" -le 1 ] || { usage >&2; exit 2; } ;;
  *) usage >&2; exit 2 ;;
esac

command -v ollama >/dev/null 2>&1 || { printf '%s\n' 'error: Ollama is required and must be running.' >&2; exit 1; }
command -v git >/dev/null 2>&1 || { printf '%s\n' 'error: git is required to initialise the project.' >&2; exit 1; }
cloud_models=$(ollama list 2>/dev/null | awk 'NR > 1 && $1 ~ /:.*cloud$/ { print $1 }') || {
  printf '%s\n' 'error: Ollama is not reachable; start it and retry.' >&2
  exit 1
}
[ -n "$cloud_models" ] || {
  printf '%s\n' 'error: no installed Ollama Cloud model was found; pull one ending in :cloud and retry.' >&2
  exit 1
}

target=${1:-}
if [ -z "$target" ]; then
  printf 'Project directory: '
  IFS= read -r target || exit 1
fi
[ -n "$target" ] || { printf '%s\n' 'error: project directory is required.' >&2; exit 1; }
parent=$(dirname "$target")
[ -d "$parent" ] || { printf 'error: project parent does not exist: %s\n' "$parent" >&2; exit 1; }
if [ -e "$target" ]; then
  [ -d "$target" ] && [ ! -L "$target" ] || { printf 'error: project directory is unsafe: %s\n' "$target" >&2; exit 1; }
  [ -z "$(find "$target" -mindepth 1 -maxdepth 1 -print -quit)" ] || { printf 'error: project directory must be empty: %s\n' "$target" >&2; exit 1; }
fi

printf 'Project name [%s]: ' "$(basename "$target")"
IFS= read -r name || exit 1
[ -n "$name" ] || name=$(basename "$target")

manager_model=$(choose_model manager)
graph_model=$(choose_model graph)
developer_model=$(choose_model developer)
reviewer_model=$(choose_model reviewer)

printf '\nEnable token optimization (RTK + Tilth)? [Y/n] '
IFS= read -r token_answer || exit 1
case "$token_answer" in n|N|no|NO) token_option=--no-token-optimization ;; *) token_option=--token-optimization ;; esac
printf 'Enable local token monitoring proxy? [y/N] '
IFS= read -r monitor_answer || exit 1
case "$monitor_answer" in y|Y|yes|YES) monitor_option=--token-monitoring ;; *) monitor_option= ;; esac

printf '\nProject: %s\nManager: %s\nGraph: %s\nDeveloper: %s\nReviewer: %s\nGit: initialise repository\nContinue? [y/N] ' \
  "$target" "$manager_model" "$graph_model" "$developer_model" "$reviewer_model"
IFS= read -r confirm || exit 1
case "$confirm" in y|Y|yes|YES) : ;; *) printf '%s\n' 'Cancelled.'; exit 0 ;; esac

"$ROOT/install.sh" "$target" --name "$name" --profile web --claude-ollama-cloud \
  --manager-model "$manager_model" --graph-model "$graph_model" \
  --developer-model "$developer_model" --reviewer-model "$reviewer_model" \
  "$token_option" $monitor_option --yes
git -C "$target" init >/dev/null
printf 'Git repository initialised: %s/.git\n' "$target"
if is_monitored_project "$target"; then
  monitor_start "$target"
  printf 'Open a live token monitoring terminal? [y/N] '
  IFS= read -r terminal_answer || exit 1
  case "$terminal_answer" in y|Y|yes|YES) open_monitor_terminal "$target" ;; *) : ;; esac
fi
printf 'Create an initial CCB brief now? [y/N] '
IFS= read -r brief_answer || exit 1
case "$brief_answer" in
  y|Y|yes|YES) write_brief "$target" initial-brief ;;
  *) : ;;
esac
printf 'Start CCB now? [Y/n] '
IFS= read -r start_answer || exit 1
case "$start_answer" in
  n|N|no|NO) if is_monitored_project "$target"; then printf 'CCB was not started. Run: %s start %s\n' "$ROOT/ccb-template" "$target"; else printf 'CCB was not started. Run: cd %s && ccb\n' "$target"; fi ;;
  *) if is_monitored_project "$target"; then monitor_start "$target"; fi; cd "$target" && exec ccb ;;
esac
