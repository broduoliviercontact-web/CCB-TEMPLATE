# BEGIN CCB TEMPLATE
# CCB runtime and recoverable state
.ccb/backups/
.ccb/ccbd/
.ccb/workspaces/
.ccb/.claude-*-session
.ccb/*.log
.ccb/*.pid
.ccb/agents/*/cancel_flags/
.ccb/agents/*/jobs.jsonl
.ccb/agents/*/logs/
.ccb/agents/*/sessions/
.ccb/agents/*/provider-state/
.ccb/agents/*/restore.json
.ccb/agents/*/history/
.ccb/agents/*/histories/
.ccb/agents/*/history.json
.ccb/agents/*/history.jsonl

# Graph artifacts are local unless explicitly exported elsewhere.
graphify-out/
!graphify-out/
graphify-out/*
!graphify-out/.gitkeep

# Graphiste artifacts are local unless explicitly exported elsewhere.
graphiste-out/
!graphiste-out/
graphiste-out/*
!graphiste-out/.gitkeep
# END CCB TEMPLATE
